# --- Secrets (do not commit real values) ---
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WANDB_API_KEY=

# --- Model / run configuration ---
BASE_MODEL_NAME=unsloth/llama-3-8b-bnb-4bit
